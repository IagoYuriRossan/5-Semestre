### ========================================
### API DE EVENTOS - SISTEMA DE AUDITORIA
### ========================================

### Health Check
GET http://localhost:3001/health

### ----------------------------------------
### CADASTRO - Registrar criação de usuário
### ----------------------------------------
POST http://localhost:3001/api/eventos
Content-Type: application/json

{
  "acao": "cadastro",
  "userId": 1,
  "userName": "João Silva",
  "campos": [
    { "campo": "nome", "valor": "João Silva" },
    { "campo": "email", "valor": "joao@email.com" },
    { "campo": "telefone", "valor": "(11) 98765-4321" },
    { "campo": "cep", "valor": "01310-100" },
    { "campo": "rua", "valor": "Avenida Paulista" },
    { "campo": "numero", "valor": "1000" },
    { "campo": "bairro", "valor": "Bela Vista" },
    { "campo": "cidade", "valor": "São Paulo" },
    { "campo": "uf", "valor": "SP" }
  ]
}

### ----------------------------------------
### ALTERAÇÃO - Registrar atualização de usuário
### ----------------------------------------
POST http://localhost:3001/api/eventos
Content-Type: application/json

{
  "acao": "alteracao",
  "userId": 1,
  "userName": "João da Silva Santos",
  "campos": [
    {
      "campo": "nome",
      "antes": "João Silva",
      "depois": "João da Silva Santos"
    },
    {
      "campo": "telefone",
      "antes": "(11) 98765-4321",
      "depois": "(11) 99999-9999"
    },
    {
      "campo": "rua",
      "antes": "Avenida Paulista",
      "depois": "Rua Augusta"
    },
    {
      "campo": "numero",
      "antes": "1000",
      "depois": "500"
    }
  ]
}

### ----------------------------------------
### EXCLUSÃO - Registrar remoção de usuário
### ----------------------------------------
POST http://localhost:3001/api/eventos
Content-Type: application/json

{
  "acao": "exclusao",
  "userId": 1,
  "userName": "João Silva",
  "campos": [
    { "campo": "nome", "valor": "João Silva" },
    { "campo": "email", "valor": "joao@email.com" },
    { "campo": "telefone", "valor": "(11) 98765-4321" },
    { "campo": "cep", "valor": "01310-100" },
    { "campo": "rua", "valor": "Avenida Paulista" },
    { "campo": "numero", "valor": "1000" },
    { "campo": "bairro", "valor": "Bela Vista" },
    { "campo": "cidade", "valor": "São Paulo" },
    { "campo": "uf", "valor": "SP" }
  ]
}

### ----------------------------------------
### CONSULTA - Busca por ID
### ----------------------------------------
POST http://localhost:3001/api/eventos
Content-Type: application/json

{
  "acao": "consulta",
  "buscadoPor": "id",
  "usuarios": [
    {
      "userId": 1,
      "nome": "João Silva",
      "email": "joao@email.com",
      "telefone": "(11) 98765-4321",
      "endereco": "Avenida Paulista, 1000 - Bela Vista, São Paulo/SP"
    }
  ]
}

