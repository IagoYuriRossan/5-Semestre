# ============================================
# SERVER ENVIRONMENT VARIABLES (Backend)
# ============================================
# 
# NÃO ALTERE ESSES VALORES NA APRESENTAÇÃO!
# O backend sempre roda em localhost
#

# Porta do servidor Node.js (backend)
PORT=3001

# URI de conexão do MongoDB (sempre localhost - mesma máquina)
MONGO_URI=mongodb://localhost:27017

# Nome do banco de dados no MongoDB
DB_NAME=atividadeFinalMobile

# ============================================
# INSTRUÇÕES:
# ============================================
# 1. Copie este arquivo e renomeie para .env
# 2. NÃO precisa alterar nada aqui
# 3. O IP da máquina só vai no Front/.env
